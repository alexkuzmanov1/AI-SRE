# Data source for the IncidentClient seam.
#   mock -> in-memory fixtures (default; works fully offline, no backend needed)
#   api  -> real responder backend over HTTP + SSE
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL of the responder backend. Only used when NEXT_PUBLIC_DATA_SOURCE=api.
NEXT_PUBLIC_RESPONDER_URL=http://localhost:3001
